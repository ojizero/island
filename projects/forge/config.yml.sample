# Forgejo runner config for the forge stack (DIND sidecar).
#
# 1. Generate a baseline and copy to ${FORGEJO_RUNNER_DATA_PATH}/config.yml:
#      docker run --rm code.forgejo.org/forgejo/runner:13.2.1 \
#        forgejo-runner generate-config > configs/runner/data/config.yml
#    Then merge in the `runner.labels` and `container` sections from this file.
#
# 2. Create a registration token (Site administration → Actions → Runners):
#      docker exec -u git forgejo forgejo actions generate-runner-token
#
# 3. Register once before starting the daemon. Use the internal Forgejo URL
#    as <container>.<network>: jobs get it as GITHUB_SERVER_URL, and dind's
#    DNS does not forward single-label names such as `forgejo`.
#      docker compose run --rm --no-deps forgejo-runner \
#        forgejo-runner register --config /data/config.yml --no-interactive \
#        --instance http://forgejo.forgejo-actions:3000 \
#        --token <registration-token> \
#        --name atlas-forgejo-runner
#    Labels are taken from `runner.labels` below, not the CLI `--labels` flag.
#
# 4. Start the stack: docker compose up -d

log:
  level: info
  job_level: info

runner:
  file: .runner
  capacity: 1
  timeout: 3h
  shutdown_timeout: 3h
  insecure: false
  fetch_timeout: 30s
  fetch_interval: 2s
  report_interval: 1s
  labels:
    - "docker:docker://node:22-bookworm"
    - "ubuntu-latest:docker://node:22-bookworm"

cache:
  enabled: true
  port: 0
  dir: ""
  external_server: ""
  secret: ""
  # Job containers run inside dind. Its DNS forwards only dotted names,
  # so use <container>.<network>.
  host: "forgejo-runner.forgejo-actions"
  proxy_port: 4001

container:
  network: ""
  enable_ipv6: false
  # A privileged job sees Atlas's disks and kernel through dind: it is root
  # on Atlas. See AGENTS.md "Docker lockdown".
  privileged: false
  valid_volumes: []
  docker_host: "-"
  force_pull: false
  force_rebuild: false

host:
  workdir_parent:

server:
  connections:
