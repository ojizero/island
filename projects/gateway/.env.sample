# Cloudflare configurations to allow LEGO to perform DNS
# challenge for SSL/TLS with Let's Encrypt
CF_API_EMAIL=
CF_API_KEY=
CF_DNS_API_TOKEN=

# Do not follow CNAME records while locating the DNS-01 challenge zone.
# The *.tn.ojizero.dev CNAME points at the Tailscale hostname, whose DNS server
# does not implement the SOA query LEGO uses for zone discovery. Without this,
# renewal fails while looking up atlas.border-aeolian.ts.net instead of writing
# _acme-challenge records in the ojizero.dev Cloudflare zone.
LEGO_DISABLE_CNAME_SUPPORT=true

# A user to be granted access to Traefik's dashboard,
# password must be hashed by `htpasswd`
TRAEFIK_DASHBOARD_USER=
TRAEFIK_DASHBOARD_PASS_HASH=
