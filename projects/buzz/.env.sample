# Paths for persistent data (gitignored under configs/).
BUZZ_POSTGRES_PATH=./configs/postgres
BUZZ_REDIS_PATH=./configs/redis
BUZZ_RUSTFS_PATH=./configs/rustfs
BUZZ_GIT_PATH=./configs/git

# Deployment community seeded from RELAY_URL's host at startup (required by Buzz).
# Apex buzz.tn.ojizero.dev is that seed community even if we keep it empty and put
# real workspaces under *.buzz.tn.ojizero.dev (e.g. friends.buzz.tn.ojizero.dev).
# Extra communities: POST /operator/communities (requires operator env below).
BUZZ_DOMAIN=buzz.tn.ojizero.dev
RELAY_URL=wss://buzz.tn.ojizero.dev
BUZZ_MEDIA_BASE_URL=https://buzz.tn.ojizero.dev/media
BUZZ_MEDIA_SERVER_DOMAIN=buzz.tn.ojizero.dev

# CORS: Buzz accepts an exact origin list or, when empty, CorsLayer::permissive().
# It does NOT support https://*.buzz… wildcards (literal "*.buzz" will not match
# browser Origins). Empty = allow any Origin (broader than *.buzz, but the only
# non-hack multi-community option without maintaining a growing exact list).
BUZZ_CORS_ORIGINS=

# Closed relay (membership scoped per host-derived community).
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
BUZZ_S3_REGION=us-east-1
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info

# Owner of the deployment community (RELAY_URL host). Private key stays on the client.
RELAY_OWNER_PUBKEY=

# Multi-community provisioning (optional). Empty pubkeys = provisioning disabled.
# RELAY_OPERATOR_API_ORIGIN is required when pubkeys are set.
# RELAY_OPERATOR_PUBKEYS=
# RELAY_OPERATOR_API_ORIGIN=https://buzz.tn.ojizero.dev

# Deployment-admin SPA (bundled at /srv/buzz/admin-web since post-0.2.0 images).
# Exact Host authority — must NOT be a community host you care about; admin SPA
# wins over the public invite/web bundle on this host. Prefer a dedicated name.
# BUZZ_ADMIN_WEB_DIR is set in the image; override only if mounting a custom build.
BUZZ_ADMIN_HOST=admin.buzz.tn.ojizero.dev

# Path-style S3 URLs for in-cluster RustFS (upstream default; explicit for clarity).
BUZZ_S3_ADDRESSING_STYLE=path

# Stable secrets: generate once, back up, do not rotate on restart.
# openssl rand -hex 32
BUZZ_RELAY_PRIVATE_KEY=
BUZZ_GIT_HOOK_HMAC_SECRET=

POSTGRES_DB=buzz
POSTGRES_USER=buzz
# Prefer URL-safe chars (no @ : / ?) so DATABASE_URL interpolation stays valid.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# S3 credentials for RustFS (mapped to RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY).
# No special Buzz format — use unique random values; never ship rustfsadmin defaults.
#   Access key (identifier-like):  openssl rand -hex 16
#   Secret key (long random):      openssl rand -hex 32   # or: openssl rand -base64 32
# Generate once and keep stable; rotating requires updating Buzz + RustFS together.
# Prefer hex if you want shell/env-safe characters; ≥8 chars each, secret much longer.
BUZZ_S3_ACCESS_KEY=
BUZZ_S3_SECRET_KEY=
BUZZ_S3_BUCKET=buzz-media

# Bring-up on Atlas:
# 1. Cloudflare DNS: add wildcard *.buzz.tn.ojizero.dev -> same Atlas/Tailscale
#    target as *.tn.ojizero.dev (existing *.tn does NOT cover nested labels).
#    Apex buzz.tn.ojizero.dev is already covered by *.tn.ojizero.dev.
# 2. Redeploy/reload gateway so ACME picks up *.buzz.tn.ojizero.dev SAN.
# 3. cp .env.sample .env && chmod 600 .env; fill secrets + RELAY_OWNER_PUBKEY.
# 4. docker compose --env-file .env up -d --wait
# 5. Smoke: curl -fsS https://buzz.tn.ojizero.dev/info
# 6. Admin UI (sha-* / post-0.2.0 images): open https://admin.buzz.tn.ojizero.dev
#    (served when BUZZ_ADMIN_HOST matches; do not provision that host as a community).
# 7. Real communities: set RELAY_OPERATOR_*; POST /operator/communities with
#    { "host": "friends.buzz.tn.ojizero.dev", "initial_owner_pubkey": "..." }
#    then join wss://friends.buzz.tn.ojizero.dev
#
# Side effects / constraints to be aware of:
# - One host == one community. No domain aliases for the same workspace.
# - Apex is the required RELAY_URL seed community; it can stay empty of channels.
# - Changing RELAY_URL later is NOT a rename: Buzz seeds a new empty community
#   under the new host; old data stays keyed to the previous host. Prefer keeping
#   the apex stable, or migrate/export deliberately if you must move.
# - Unmapped hosts under the Traefik wildcard reach the relay but fail closed.
# - BUZZ_ADMIN_HOST steals HTML/SPA on that exact Host; keep it off community hosts.
# - BUZZ_MEDIA_BASE_URL is a single deployment URL (apex). Per-community media
#   absolute URLs may still advertise the apex; validate with a second community.
# - CORS empty = permissive (any Origin), not limited to *.buzz.tn.ojizero.dev.
# - Public *.buzz.ojizero.dev is intentionally out of scope for now.
#
# Optional key helpers after relay is up:
#   docker compose exec relay buzz-admin generate-key
#   docker compose exec relay buzz-admin --help
