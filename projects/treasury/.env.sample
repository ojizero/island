## Sure
#
# sure-web and sure-worker read this whole file. compose.yml sets the
# host-specific values (domain, TLS, database and Redis hosts, assistant
# type). All variables: https://github.com/we-promise/sure/blob/v0.7.6/.env.example
#
# After you create the first account, set Settings > Self-Hosting >
# Onboarding to closed.

# Database. sure-db creates it on first start; Sure connects with the
# same values.
POSTGRES_DB=sure_production
POSTGRES_USER=sure
# Generate with `openssl rand -hex 32`.
POSTGRES_PASSWORD=

# Signs sessions and encrypts stored credentials (such as the IBKR Flex
# token). Generate with `openssl rand -hex 64`. Do not change it after
# the first start: Sure can then no longer read the encrypted data.
SECRET_KEY_BASE=

# Market data and exchange rates, free and with no key.
EXCHANGE_RATE_PROVIDER=yahoo_finance
SECURITIES_PROVIDER=yahoo_finance
