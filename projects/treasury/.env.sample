## Sure
#
# sure-web and sure-worker read this whole file. compose.yml sets the
# host-specific values (domain, TLS, database and Redis hosts, assistant
# type). All variables: https://github.com/we-promise/sure/blob/v0.7.6/.env.example
#
# After you create the first account, set Settings > Self-Hosting >
# Onboarding to closed.

# Database. sure-db creates it on first start; Sure connects with the
# same values.
POSTGRES_DB=sure_production
POSTGRES_USER=sure
# Generate with `openssl rand -hex 32`.
POSTGRES_PASSWORD=

# Signs sessions and encrypts the secrets in Settings. Generate with
# `openssl rand -hex 64`. Do not change it after the first start: Sure
# can then no longer read those secrets.
SECRET_KEY_BASE=

# Encrypt stored credentials (such as the IBKR Flex token), provider
# data, MFA secrets, and user emails and names. Set all three or none:
# with only some, Sure does not start. Generate a set with
# `docker exec sure-web bin/rails db:encryption:init`.
# Never change them: Sure 0.7.6 cannot rotate them, and data encrypted
# with old keys cannot be read. Keep a copy off Atlas, with
# SECRET_KEY_BASE. A database backup needs the keys that were set when
# it was taken.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Market data and exchange rates, free and with no key.
EXCHANGE_RATE_PROVIDER=yahoo_finance
SECURITIES_PROVIDER=yahoo_finance
